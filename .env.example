# Copy to .env (never commit .env). Values here are placeholders only.

# --- Mobile app (passed with --dart-define-from-file, see README) ---
# The versioned API (local Worker: cd functions && npm run dev). The app reads and
# writes data only through it (ADR-0012). From the Android emulator use
# http://10.0.2.2:8787/v1 and set API_HOST=10.0.2.2 in functions/.dev.vars.
API_BASE_URL=http://api.localhost:8787/v1
# Supabase is used for sign-in only.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key-from-supabase-status
# Google sign-in: the OAuth "Web" client id of the Google Cloud project behind
# this Supabase project (ADR-0021). Public, but per environment. Google is
# the only sign-in on Android (ADR-0022), so without it nobody can sign in.
GOOGLE_WEB_CLIENT_ID=
SENTRY_DSN=
APP_ENV=dev

# --- Workers secrets (set with `wrangler secret put <NAME> --env <env>`) ---
# SENTRY_DSN=
# The database connection is a Hyperdrive binding in wrangler.jsonc (M2), not a
# secret here. There are no database webhooks (ADR-0012).
