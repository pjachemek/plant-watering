{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plants.pampait.pl/schemas/presets.schema.json",
  "title": "Plant NFC care presets",
  "description": "Curated houseplant care presets bundled with the app (AGENTS.md section 8, ADR-0028). Care text is original wording; facts are checked against the listed sources.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "presets"],
  "properties": {
    "version": {
      "description": "Bumped with every change. Plants keep the version they were created from, so an update never silently changes a plant.",
      "type": "integer",
      "minimum": 1
    },
    "presets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/preset" }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$"
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "common_name",
        "latin_name",
        "aliases",
        "interval_summer_days",
        "interval_winter_days",
        "method",
        "amount",
        "soil_check",
        "light",
        "tips",
        "pet_toxic",
        "sources"
      ],
      "properties": {
        "id": {
          "description": "Stable slug; stored on plants as preset_id, so it never changes.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "common_name": {
          "description": "The English name shown in the app.",
          "allOf": [{ "$ref": "#/$defs/text" }, { "type": "string", "maxLength": 60 }]
        },
        "latin_name": {
          "allOf": [{ "$ref": "#/$defs/text" }, { "type": "string", "maxLength": 80 }]
        },
        "aliases": {
          "description": "Other names people search by, with their language.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "lang"],
            "properties": {
              "name": { "allOf": [{ "$ref": "#/$defs/text" }, { "type": "string", "maxLength": 60 }] },
              "lang": { "enum": ["en", "pl"] }
            }
          }
        },
        "interval_summer_days": { "type": "integer", "minimum": 1, "maximum": 60 },
        "interval_winter_days": { "type": "integer", "minimum": 1, "maximum": 60 },
        "method": {
          "description": "top: from above; bottom: from the saucer; soak: dunk the pot; mist: spray the leaves.",
          "enum": ["top", "bottom", "soak", "mist"]
        },
        "amount": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size", "hint"],
          "properties": {
            "size": { "enum": ["small", "medium", "large"] },
            "hint": {
              "description": "Plain language, for example \"until water runs from the drainage holes\".",
              "allOf": [{ "$ref": "#/$defs/text" }, { "type": "string", "maxLength": 100 }]
            }
          }
        },
        "soil_check": {
          "description": "When to water, for example \"top 2 cm dry\".",
          "allOf": [{ "$ref": "#/$defs/text" }, { "type": "string", "maxLength": 80 }]
        },
        "light": {
          "allOf": [{ "$ref": "#/$defs/text" }, { "type": "string", "maxLength": 80 }]
        },
        "tips": {
          "type": "array",
          "maxItems": 3,
          "items": { "allOf": [{ "$ref": "#/$defs/text" }, { "type": "string", "maxLength": 119 }] }
        },
        "pet_toxic": { "enum": ["yes", "no", "unknown"] },
        "sources": {
          "description": "Reputable references the facts were checked against. Text is never copied from them.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "url"],
            "properties": {
              "title": { "allOf": [{ "$ref": "#/$defs/text" }, { "type": "string", "maxLength": 120 }] },
              "url": { "type": "string", "format": "uri", "pattern": "^https://" }
            }
          }
        }
      }
    }
  }
}
