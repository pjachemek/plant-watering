    {
      "name": "households",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"households\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"public_cards_enabled\" INTEGER NOT NULL CHECK (\"public_cards_enabled\" IN (0, 1)), \"hemisphere\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "members",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"members\" (\"id\" TEXT NOT NULL, \"household_id\" TEXT NOT NULL, \"user_id\" TEXT NOT NULL, \"display_name\" TEXT NOT NULL, \"joined_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "plants",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"plants\" (\"id\" TEXT NOT NULL, \"household_id\" TEXT NOT NULL, \"nickname\" TEXT NOT NULL, \"preset_id\" TEXT NULL, \"preset_version\" INTEGER NULL, \"room\" TEXT NULL, \"photo_path\" TEXT NULL, \"interval_summer_days\" INTEGER NULL, \"interval_winter_days\" INTEGER NULL, \"amount\" TEXT NULL, \"method\" TEXT NULL, \"notes\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tags\" (\"id\" TEXT NOT NULL, \"household_id\" TEXT NOT NULL, \"token\" TEXT NOT NULL, \"plant_id\" TEXT NULL, \"written_at\" TEXT NULL, \"written_by\" TEXT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
