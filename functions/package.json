{
  "name": "plant-nfc-functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "types": "wrangler types",
    "types:check": "wrangler types --check",
    "generate:api": "openapi-ts && node scripts/generate-operations.mjs && prettier --write src/api/generated",
    "lint:api": "redocly lint",
    "deploy:development": "wrangler deploy --env development"
  },
  "dependencies": {
    "@sentry/cloudflare": "11.8.0",
    "hono": "4.13.13",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.8",
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@redocly/cli": "2.71.2",
    "@types/js-yaml": "4.0.9",
    "@types/pg": "8.23.1",
    "@vitest/coverage-istanbul": "5.0.5",
    "eslint": "10.13.0",
    "js-yaml": "5.5.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "wrangler": "4.153.0"
  },
  "allowScripts": {
    "workerd@1.20261019.1": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "undici": "7.30.1",
    "zod": "4.6.7",
    "js-yaml": "5.5.0"
  }
}
