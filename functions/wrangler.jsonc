// Cloudflare Workers config: the versioned API on API_HOST and the web pages on
// every other host, from one Worker (ADR-0004, ADR-0012).
// Secrets (SENTRY_DSN) are set with `wrangler secret put`, never committed.
// Postgres is reached through a Hyperdrive binding, added in M2. See ../.env.example.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plant-nfc-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Rate limiters are not inherited by environments, so each declares its own
  // counters (separate namespaces).
  "ratelimits": [
    // Per signed-in user on every authenticated endpoint (AGENTS.md section 6).
    {
      "name": "USER_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 },
    },
    // Per IP on public endpoints.
    { "name": "IP_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
  ],
  // Postgres through Hyperdrive as the plantnfc_api role (ADR-0017). Locally
  // the binding connects straight to the Supabase CLI stack with its
  // local-only password (supabase/seed.sql); the id is unused there.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://plantnfc_api:local-dev-only@127.0.0.1:54322/postgres",
    },
  ],
  "vars": {
    "APP_ENV": "dev",
    // Version policy until it moves to the client_versions table (M2.4).
    "MIN_APP_VERSION": "0.1.0",
    "RECOMMENDED_APP_VERSION": "0.1.0",
    // *.localhost resolves to this machine: curl http://api.localhost:8787/health
    "API_HOST": "api.localhost",
    "SUPABASE_URL": "http://127.0.0.1:54321",
  },
  "env": {
    // Deployed, against the Supabase dev project: for device testing before
    // staging exists. Local `wrangler dev` stays on the local Supabase stack.
    "development": {
      "name": "plant-nfc-development",
      "routes": [{ "pattern": "api-dev.plants.pampait.pl", "custom_domain": true }],
      "ratelimits": [
        {
          "name": "USER_RATE_LIMITER",
          "namespace_id": "4001",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "IP_RATE_LIMITER",
          "namespace_id": "4002",
          "simple": { "limit": 60, "period": 60 },
        },
      ],
      "vars": {
        "APP_ENV": "development",
        "API_HOST": "api-dev.plants.pampait.pl",
        "MIN_APP_VERSION": "0.1.0",
        "RECOMMENDED_APP_VERSION": "0.1.0",
        "SUPABASE_URL": "https://utqhpnnkbiafgpnsliuz.supabase.co",
      },
    },
    "staging": {
      "name": "plant-nfc-staging",
      "ratelimits": [
        // Per signed-in user on every authenticated endpoint (AGENTS.md section 6).
        {
          "name": "USER_RATE_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 120, "period": 60 },
        },
        // Per IP on public endpoints.
        {
          "name": "IP_RATE_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 60, "period": 60 },
        },
      ],
      "vars": {
        "APP_ENV": "staging",
        "MIN_APP_VERSION": "0.1.0",
        "RECOMMENDED_APP_VERSION": "0.1.0",
        "API_HOST": "api.staging.plants.pampait.pl",
        "SUPABASE_URL": "https://STAGING_PROJECT_REF.supabase.co",
      },
    },
    "production": {
      "name": "plant-nfc-production",
      // Needs the pampait.pl zone on this Cloudflare account (docs/deploy.md).
      "routes": [
        { "pattern": "plants.pampait.pl", "custom_domain": true },
        { "pattern": "api.plants.pampait.pl", "custom_domain": true },
      ],
      "ratelimits": [
        // Per signed-in user on every authenticated endpoint (AGENTS.md section 6).
        {
          "name": "USER_RATE_LIMITER",
          "namespace_id": "3001",
          "simple": { "limit": 120, "period": 60 },
        },
        // Per IP on public endpoints.
        {
          "name": "IP_RATE_LIMITER",
          "namespace_id": "3002",
          "simple": { "limit": 60, "period": 60 },
        },
      ],
      "vars": {
        "APP_ENV": "production",
        "MIN_APP_VERSION": "0.1.0",
        "RECOMMENDED_APP_VERSION": "0.1.0",
        "API_HOST": "api.plants.pampait.pl",
        "SUPABASE_URL": "https://PROD_PROJECT_REF.supabase.co",
      },
    },
  },
}
